AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
SFTP_DIR=/home/sftpuser
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.1

_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin123

# Optional - Only if you want to install additional Python packages
_PIP_ADDITIONAL_REQUIREMENTS=

# Ports (can be changed if you want to avoid conflicts)
AIRFLOW__WEBSERVER__PORT=8080
FLOWER_PORT=5555
